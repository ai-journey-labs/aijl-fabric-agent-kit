# Store and check out text files with LF line endings on every platform, so that
# diffs, the skills sync check and the setup script behave the same on Windows,
# macOS and Linux. Editors on all three handle LF.
* text=auto eol=lf

# Reference documents and images are binary.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary

# Certificate and key files must never be committed (see .gitignore). If one is
# added by mistake, never let git rewrite it.
*.pem binary
*.pfx binary
*.key binary
*.crt binary
